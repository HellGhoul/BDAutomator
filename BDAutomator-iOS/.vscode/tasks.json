{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build iOS App",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "BDAutomator.xcodeproj",
                "-scheme",
                "BDAutomator",
                "-destination",
                "platform=iOS Simulator,name=iPhone 15,OS=latest",
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build for Device",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "BDAutomator.xcodeproj",
                "-scheme",
                "BDAutomator",
                "-destination",
                "platform=iOS,id=YOUR_DEVICE_ID",
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "BDAutomator.xcodeproj",
                "-scheme",
                "BDAutomator",
                "clean"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Swift Package",
            "type": "shell",
            "command": "swift",
            "args": ["run"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
