{
    "swift.path": "/usr/bin/swift",
    "swift.buildPath": "./build",
    "swift.target": "BDAutomator",
    "swift.scheme": "BDAutomator",
    "swift.configuration": "Debug",
    "swift.simulator": "iPhone 15",
    "swift.sdk": "iphoneos",
    "swift.deploymentTarget": "15.0",
    "files.associations": {
        "*.swift": "swift",
        "*.xcdatamodel": "xml",
        "*.plist": "xml"
    },
    "editor.formatOnSave": true,
    "editor.rulers": [120],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
